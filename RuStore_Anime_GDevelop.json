  "eventsFunctions": [
    {
      "name": "Initialize",
      "fullName": "Подключить RuStore",
      "functionType": "Action",
      "sentence": "Подключить RuStore",
      "description": "",
      "group": "RuStore",
      "parameters": [],
      "objectGroups": [],
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "if (!gdjs.animeRuStore) {",
            "  gdjs.animeRuStore = {",
            "    data: {paid:0, price:null, busy:false, review:false}, listeners:[], connected:false,",
            "    call(action,args=[]) {",
            "      return new Promise((resolve,reject)=>{",
            "        if (!globalThis.cordova || typeof cordova.exec !== 'function') {",
            "          reject(new Error('RuStore доступен в установленной Android-сборке')); return;",
            "        }",
            "        cordova.exec(resolve,reject,'AnimeRuStore',action,args);",
            "      });",
            "    },",
            "    subscribe(listener) { this.listeners.push(listener);listener(this.data);this.connect(); },",
            "    connect() {",
            "      if(this.connected || !globalThis.cordova || typeof cordova.exec !== 'function')return;",
            "      this.connected=true;",
            "      cordova.exec(data=>{",
            "        this.data=data;",
            "        for(const listener of this.listeners)listener(data);",
            "      },error=>{",
            "        this.connected=false;",
            "        this.data={...this.data,price:null,busy:false,message:String(error && error.message || error)};",
            "        for(const listener of this.listeners)listener(this.data);",
            "      },'AnimeRuStore','subscribe',[]);",
            "    }",
            "  };",
            "  if(typeof document !== 'undefined') document.addEventListener('deviceready',()=>gdjs.animeRuStore.connect(),{once:true});",
            "}",
            "gdjs.animeRuStore.connect();",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ]
    },
